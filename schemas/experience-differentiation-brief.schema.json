      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "What learners primarily do; distinguish the action from the UI control."
    },
    "emotional_cognitive_rhythm": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Intended attention, uncertainty, effort, feedback and relief over time."
    },
    "visual_interaction_metaphor": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Principal metaphor using governed visual resources; no new visual system implied."
    },
    "density_scroll_expectation": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Expected information density, scroll length and maximum-content behavior."
    },
    "reference_work_balance": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "What remains available as reference while the learner works, and why."
    },
    "authored_writing_burden": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Authored fields, hard maxima, structural sufficiency and concise guidance; justify any pedagogically necessary minimum."
    },
    "desktop_mobile_transformation": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Changes in arrangement, reading order, controls and comparisons at existing breakpoints."
    },
    "magnetic_experience_moment": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Specific moment of curiosity, agency or meaningful discovery, with a testable rationale."
    },
    "reuse_rationale": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Registered patterns/components and variants, their fit and limits; declare System Gaps explicitly."
    },
    "difference_from_recent_references": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Compare dominant action, rhythm, metaphor, density and writing burden with recent references; avoid cosmetic differentiation."
