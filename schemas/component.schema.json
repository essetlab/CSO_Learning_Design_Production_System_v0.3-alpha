{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CSO System Object",
  "type": "object",
  "required": [
    "id",
    "version",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]+-[A-Z0-9-]+-[0-9]{2}$|^SHELL-[A-Z0-9-]+-[0-9]{2}$"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    }
  }
}
